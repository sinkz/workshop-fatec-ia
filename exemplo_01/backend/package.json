{
  "name": "sales-api-backend",
  "version": "1.0.0",
  "description": "Backend API for Sales and Products management",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "json-server": "json-server --watch db.json --port 3002",
    "dev:full": "concurrently \"npm run json-server\" \"npm run dev\"",
    "start:full": "concurrently \"npm run json-server\" \"npm start\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.1",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "json-server": "^0.17.4",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.0",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
